{
  "name": "Node.js",
  "id": "nodejs",
  "description": "Install Node.js.",
  "version": "0.0.8",
  "options": {
    "nv": {
      "type": "string",
      "description": "Which version of Node.js to install?",
      "enum": [
        "22",
        "24",
        "26"
      ],
      "default": "26"
    },
    "pm": {
      "type": "string",
      "description": "Which package manager to install?",
      "enum": [
        "npm",
        "pnpm",
        "yarn"
      ],
      "default": "npm"
    }
  },
  "installsAfter": [
    "ghcr.io/raroh73/devcontainer-features/update"
  ]
}
